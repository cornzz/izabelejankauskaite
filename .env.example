# Copy to .env.local for local dev, and set the same values in the Vercel dashboard.
# Pull the Vercel-managed values locally with: vercel env pull .env.local

# Neon pooled connection string. Auto-injected by the Neon Vercel integration
# (Storage → Neon). Locally, comes from `vercel env pull`.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# HMAC secret for signing the session + WebAuthn challenge cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"

# WebAuthn Relying Party ID = the bare domain (no scheme/port).
# Use "localhost" for local dev, "izabelejankauskaite.com" in production.
RP_ID="localhost"

# Full origin, including scheme (and port in dev).
# "http://localhost:5173" locally, "https://izabelejankauskaite.com" in production.
ORIGIN="http://localhost:5173"

# Display name shown in the passkey prompt.
RP_NAME="Izabelė Jankauskaitė"

# Random token used to revalidate the ISR-cached public page after an edit.
# Generate one with: openssl rand -base64 32
ISR_BYPASS_TOKEN="change-me"
