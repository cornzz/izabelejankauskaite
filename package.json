{
	"name": "izabelejankauskaite",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
		"db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
		"calendar:migrate": "node --env-file=.env.local --import tsx scripts/migrate-calendar.ts",
		"invite:create": "node --env-file=.env.local --import tsx scripts/create-invite.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.5.3",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/node": "^22.10.10",
		"autoprefixer": "^10.4.17",
		"drizzle-kit": "^0.31.10",
		"photoswipe": "^5.4.4",
		"photoswipe-dynamic-caption-plugin": "^1.2.7",
		"postcss": "^8.4.33",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.4.1",
		"tsx": "^4.23.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3"
	},
	"type": "module",
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"@vercel/analytics": "^1.3.1",
		"drizzle-orm": "^0.45.2",
		"flatpickr": "^4.6.13",
		"jose": "^6.2.3",
		"yaml": "^2.7.0"
	}
}
